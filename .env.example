APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# * Realtime /chat: set BROADCAST_CONNECTION=pusher and fill PUSHER_* (then rebuild the frontend). `null` or `log` turns realtime off.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Google Analytics 4 server-side credentials.
# GOOGLE_ANALYTICS_PROPERTY_ID=
# GOOGLE_ANALYTICS_CREDENTIALS_PATH=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# LinkedIn personal sign-in (LinkedIn Developers app). Redirect URI blank = APP_URL/integrations/linkedin/oauth/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Zalo bridge sidecar (zalo-bridge/). The same secret signs requests in both directions; the sidecar refuses to start without it.
ZALO_BRIDGE_URL=http://127.0.0.1:3790
ZALO_BRIDGE_PORT=3790
ZALO_BRIDGE_SECRET=
# Written literally: `node --env-file` does not expand ${APP_URL}.
ZALO_BRIDGE_CALLBACK_URL=http://127.0.0.1:8000
ZALO_BRIDGE_SEND_GAP_MS=2000
ZALO_BRIDGE_SEND_PER_MINUTE=10

# Messenger personal channel (unofficial, active=false until a user tests it for real; see docs/repo/messenger-mautrix-runbook.md).
# Matrix homeserver Laravel signs in to as its own user (self-hosted, not provided by this app).
MATRIX_HOMESERVER_URL=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
# mautrix-meta bridge (bridgev2) Provisioning API, reached over loopback (self-hosted, not provided by this app).
MAUTRIX_META_PROVISIONING_URL=
MAUTRIX_META_PROVISIONING_SECRET=
MAUTRIX_META_BOT_USER_ID=
MAUTRIX_META_GHOST_PREFIX=@meta_
MAUTRIX_META_SEND_PER_MINUTE=10

VITE_APP_NAME="${APP_NAME}"

# Mail module (own IMAP/SMTP client). Hosts that resolve to private/loopback addresses are refused unless this is true.
MAIL_CLIENT_ALLOW_PRIVATE_HOSTS=false
MAIL_CLIENT_INITIAL_DAYS=30
MAIL_CLIENT_INITIAL_LIMIT=500

# LinkedIn cá nhân: chuỗi cookie trình duyệt (li_at=...; JSESSIONID="ajax:...") để đăng chữ công khai qua HTTP, không mở Chrome. Chỉ để trong .env.
LINKEDIN_PERSONAL_COOKIE=

# Thư mục (cách nhau bằng dấu hai chấm) chứa lệnh claude/codex/gemini nếu web server không thấy chúng trong PATH. Để trống thì app tự thử các thư mục cài đặt phổ biến.
AI_CLI_PATH=

# AI chat "Máy local" (off by default; localhost only, never production). Roots: id=/absolute/folder,other=/folder
AI_CHAT_LOCAL_ENABLED=false
AI_CHAT_LOCAL_ROOTS=
